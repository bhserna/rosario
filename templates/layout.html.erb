<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#faf8f3">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Rosario">
  <title><%= title %></title>
  <link rel="stylesheet" href="<%= css_path %>">
  <link rel="icon" href="<%= icon_path %>">
  <link rel="apple-touch-icon" href="<%= icon_path %>">
  <link rel="manifest" href="<%= manifest_path %>">
<% unless head.empty? -%>
<%= head -%>
<% end -%>
</head>
<body>
  <main<% if label %> aria-label="<%= label %>"<% end %>>
<%= content -%>
  </main>
  <script>
    if ("serviceWorker" in navigator) navigator.serviceWorker.register("<%= sw_path %>");
  </script>
</body>
</html>
