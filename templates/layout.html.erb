<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="<%= css_path %>">
<% unless head.empty? -%>
<%= head -%>
<% end -%>
</head>
<body>
  <main<% if label %> aria-label="<%= label %>"<% end %>>
<%= content -%>
  </main>
  <script>
    if ("serviceWorker" in navigator) navigator.serviceWorker.register("<%= sw_path %>");
  </script>
</body>
</html>
