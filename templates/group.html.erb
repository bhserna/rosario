<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= group.name %></title>
  <link rel="stylesheet" href="rosario.css">
</head>
<body>
  <main>
    <a class="volver" href="index.html">← Volver al índice</a>
    <h1><%= group.name %></h1>
    <ol>
<% group.mysteries.each_with_index do |mystery, index| -%>
      <li><a href="misterios/<%= group.id %>-<%= index + 1 %>.html"><%= mystery.title %></a></li>
<% end -%>
    </ol>
  </main>
  <script>
    if ("serviceWorker" in navigator) navigator.serviceWorker.register("sw.js");
  </script>
</body>
</html>
